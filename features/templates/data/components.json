{
    "navbar_simple": {
        "name": "Simple Navbar",
        "html": "<nav class=\"tmp-navbar\">\n    <div class=\"tmp-logo\">VELOCITY</div>\n    <ul class=\"tmp-nav-links\">\n        <li><a href=\"#\">Products</a></li>\n        <li><a href=\"#\">Solutions</a></li>\n        <li><a href=\"#\">Resources</a></li>\n    </ul>\n    <div style=\"display: flex; gap: 1rem; align-items: center;\">\n        <a href=\"#\" style=\"text-decoration: none; color: #334155; font-size: 0.9rem;\">Sign In</a>\n        <a href=\"#\" class=\"btn btn-primary\">Get Started</a>\n    </div>\n</nav>"
    },
    "hero_centered": {
        "name": "Centered Hero",
        "html": "<header class=\"tmp-hero\" style=\"background: linear-gradient(to bottom, #f8fafc, #ffffff);\">\n    <h1 style=\"max-width: 900px; margin-left: auto; margin-right: auto;\">Architecting the future of digital experience.</h1>\n    <p>A unified platform that empowers developers to build, scale, and deliver exceptional software with unprecedented speed and reliability.</p>\n    <div class=\"tmp-btn-group\">\n        <a href=\"#\" class=\"btn btn-primary\" style=\"padding: 1rem 2rem;\">Explore the Platform</a>\n        <a href=\"#\" class=\"btn btn-outline\" style=\"padding: 1rem 2rem;\">Watch Overview</a>\n    </div>\n</header>"
    },
    "hero_split": {
        "name": "Split Hero",
        "html": "<header style=\"display: flex; align-items: center; padding: 6rem 5%; gap: 6rem; background: #fff;\">\n    <div style=\"flex: 1.2;\">\n        <span style=\"color: #2563eb; font-weight: 700; text-transform: uppercase; letter-spacing: 0.1em; font-size: 0.8rem; display: block; margin-bottom: 1rem;\">Engineering Excellence</span>\n        <h1 style=\"font-size: 3.5rem; margin-bottom: 1.5rem; line-height: 1.1; color: #0f172a;\">Focus on what matters most.</h1>\n        <p style=\"font-size: 1.15rem; color: #334155; margin-bottom: 2.5rem; line-height: 1.6;\">Eliminate technical debt and streamline your workflow with our production-ready infrastructure components designed for enterprise performance.</p>\n        <div style=\"display: flex; gap: 1.25rem;\">\n            <a href=\"#\" class=\"btn btn-primary\" style=\"padding: 1rem 2rem;\">Start Building</a>\n            <a href=\"#\" class=\"btn btn-outline\" style=\"padding: 1rem 2rem;\">View Components</a>\n        </div>\n    </div>\n    <div style=\"flex: 1; aspect-ratio: 16/10; background: #f8fafc; border-radius: 16px; border: 1px solid #e2e8f0; display: flex; align-items: center; justify-content: center; color: #94a3b8; box-shadow: 0 4px 20px rgba(0,0,0,0.03);\">\n        <div style=\"text-align: center;\">\n            <div style=\"width: 64px; height: 64px; background: #e2e8f0; border-radius: 16px; margin: 0 auto 1.5rem; display: flex; align-items: center; justify-content: center; color: #667eea; font-size: 2rem;\"><i class=\"fa-solid fa-rocket\"></i></div>\n            <span style=\"font-size: 0.9rem; font-weight: 500; color: #475569;\">Visual Asset Placeholder</span>\n        </div>\n    </div>\n</header>"
    },
    "features_grid": {
        "name": "Features Grid",
        "html": "<section class=\"tmp-features\" style=\"background: #ffffff;\">\n    <div style=\"text-align: center; margin-bottom: 4rem;\">\n        <h2 style=\"font-size: 2.25rem; color: #0f172a;\">Designed for modern performance</h2>\n        <p style=\"color: #475569; max-width: 600px; margin: 1rem auto 0;\">Powerful tools to help you manage every aspect of your application lifecycle.</p>\n    </div>\n    <div class=\"tmp-grid\">\n        <div class=\"tmp-feat-card\">\n            <div class=\"tmp-feat-icon\" style=\"background: #eff6ff; display: flex; align-items: center; justify-content: center; color: #3b82f6; font-size: 1.25rem;\"><i class=\"fa-solid fa-chart-line\"></i></div>\n            <h3>Intelligent Analytics</h3>\n            <p>Gain deep insights into your user behavior with real-time data processing and reporting.</p>\n        </div>\n        <div class=\"tmp-feat-card\">\n            <div class=\"tmp-feat-icon\" style=\"background: #f0fdf4; display: flex; align-items: center; justify-content: center; color: #22c55e; font-size: 1.25rem;\"><i class=\"fa-solid fa-users-gear\"></i></div>\n            <h3>Collaborative Workflow</h3>\n            <p>Ship faster with built-in collaboration tools designed for distributed engineering teams.</p>\n        </div>\n        <div class=\"tmp-feat-card\">\n            <div class=\"tmp-feat-icon\" style=\"background: #fefce8; display: flex; align-items: center; justify-content: center; color: #eab308; font-size: 1.25rem;\"><i class=\"fa-solid fa-shield-halved\"></i></div>\n            <h3>Scalable Infrastructure</h3>\n            <p>Our global edge network ensures sub-millisecond latency for your users in over 100 regions.</p>\n        </div>\n    </div>\n</section>"
    },
    "content_center": {
        "name": "Centered Content",
        "html": "<section style=\"padding: 6rem 5%; text-align: center; max-width: 850px; margin: 0 auto;\">\n    <h2 style=\"margin-bottom: 1.5rem; font-size: 2rem;\">Security you can trust</h2>\n    <p style=\"font-size: 1.1rem; color: #475569; line-height: 1.7;\">Infrastructure is critical, which is why we've built security into every layer. From hardware-level isolation to automated encryption, we ensure your data and applications are always protected by industry-leading standards.</p>\n</section>"
    },
    "footer_simple": {
        "name": "Simple Footer",
        "html": "<footer style=\"padding: 4rem 5%; border-top: 1px solid #f1f5f9; background: #fff;\">\n    <div style=\"display: flex; justify-content: space-between; align-items: flex-start; flex-wrap: wrap; gap: 2rem;\">\n        <div style=\"flex: 1; min-width: 200px;\">\n            <div style=\"font-weight: 900; font-size: 1.25rem; margin-bottom: 1rem; color: #0f172a;\">VELOCITY</div>\n            <p style=\"font-size: 0.9rem; color: #475569; line-height: 1.5;\">Building the foundational blocks for the next generation of web applications.</p>\n        </div>\n        <div style=\"display: flex; gap: 4rem;\">\n            <div style=\"display: flex; flex-direction: column; gap: 0.75rem;\">\n                <span style=\"font-weight: 700; font-size: 0.85rem; text-transform: uppercase; color: #111;\">Product</span>\n                <a href=\"#\" style=\"color: #475569; text-decoration: none; font-size: 0.9rem;\">Features</a>\n                <a href=\"#\" style=\"color: #475569; text-decoration: none; font-size: 0.9rem;\">Integrations</a>\n                <a href=\"#\" style=\"color: #475569; text-decoration: none; font-size: 0.9rem;\">Pricing</a>\n            </div>\n            <div style=\"display: flex; flex-direction: column; gap: 0.75rem;\">\n                <span style=\"font-weight: 700; font-size: 0.85rem; text-transform: uppercase; color: #111;\">Company</span>\n                <a href=\"#\" style=\"color: #475569; text-decoration: none; font-size: 0.9rem;\">About</a>\n                <a href=\"#\" style=\"color: #475569; text-decoration: none; font-size: 0.9rem;\">Blog</a>\n                <a href=\"#\" style=\"color: #475569; text-decoration: none; font-size: 0.9rem;\">Careers</a>\n            </div>\n        </div>\n    </div>\n    <div style=\"margin-top: 4rem; padding-top: 2rem; border-top: 1px solid #f1f5f9; display: flex; justify-content: space-between; align-items: center; font-size: 0.85rem; color: #94a3b8;\">\n        <div>© 2026 Velocity Systems. All rights reserved.</div>\n        <div style=\"display: flex; gap: 2rem;\">\n            <a href=\"#\" style=\"color: inherit; text-decoration: none;\">Privacy Policy</a>\n            <a href=\"#\" style=\"color: inherit; text-decoration: none;\">Terms of Service</a>\n        </div>\n    </div>\n</footer>"
    },
    "cta_banner": {
        "name": "CTA Banner",
        "html": "<section style=\"padding: 6rem 5%; background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); text-align: center; color: #fff;\">\n    <h2 style=\"font-size: 2.75rem; font-weight: 800; margin-bottom: 1.5rem; color: #fff;\">Ready to transform your workflow?</h2>\n    <p style=\"font-size: 1.25rem; margin-bottom: 2.5rem; opacity: 0.95; max-width: 700px; margin-left: auto; margin-right: auto;\">Join thousands of teams already building faster, smarter, and more efficiently with our platform.</p>\n    <div style=\"display: flex; gap: 1.25rem; justify-content: center; flex-wrap: wrap;\">\n        <a href=\"#\" class=\"btn btn-primary\" style=\"background: #fff; color: #667eea; padding: 1rem 2.5rem; font-size: 1.05rem; font-weight: 700;\">Start Free Trial</a>\n        <a href=\"#\" class=\"btn btn-outline\" style=\"border: 2px solid rgba(255,255,255,0.8); color: #fff; padding: 1rem 2.5rem; font-size: 1.05rem; font-weight: 700; background: transparent;\">Schedule Demo</a>\n    </div>\n</section>"
    },
    "testimonial_grid": {
        "name": "Testimonial Grid",
        "html": "<section style=\"padding: 6rem 5%; background: #f8fafc;\">\n    <div style=\"text-align: center; margin-bottom: 4rem;\">\n        <h2 style=\"font-size: 2.5rem; font-weight: 800; color: #0f172a; margin-bottom: 1rem;\">Loved by teams worldwide</h2>\n        <p style=\"font-size: 1.1rem; color: #64748b;\">See what our customers have to say about their experience</p>\n    </div>\n    <div style=\"display: grid; grid-template-columns: repeat(3, 1fr); gap: 2rem;\">\n        <div style=\"background: #fff; padding: 2rem; border-radius: 12px; box-shadow: 0 2px 8px rgba(0,0,0,0.04); border: 1px solid #e2e8f0;\">\n            <p style=\"font-size: 1.05rem; line-height: 1.7; color: #334155; margin-bottom: 1.5rem; font-style: italic;\">\"This platform has completely transformed how we build and ship products. The speed improvements alone have been worth it.\"</p>\n            <div style=\"display: flex; align-items: center; gap: 1rem;\">\n                <div style=\"width: 48px; height: 48px; background: linear-gradient(135deg, #667eea, #764ba2); border-radius: 50%; display: flex; align-items: center; justify-content: center; color: #fff; font-size: 1.2rem;\"><i class=\"fa-solid fa-user\"></i></div>\n                <div>\n                    <div style=\"font-weight: 700; color: #0f172a;\">Sarah Chen</div>\n                    <div style=\"font-size: 0.9rem; color: #64748b;\">CTO, TechCorp</div>\n                </div>\n            </div>\n        </div>\n        <div style=\"background: #fff; padding: 2rem; border-radius: 12px; box-shadow: 0 2px 8px rgba(0,0,0,0.04); border: 1px solid #e2e8f0;\">\n            <p style=\"font-size: 1.05rem; line-height: 1.7; color: #334155; margin-bottom: 1.5rem; font-style: italic;\">\"The best investment we've made in our development infrastructure. Our team's productivity has increased by 40%.\"</p>\n            <div style=\"display: flex; align-items: center; gap: 1rem;\">\n                <div style=\"width: 48px; height: 48px; background: linear-gradient(135deg, #f093fb, #f5576c); border-radius: 50%; display: flex; align-items: center; justify-content: center; color: #fff; font-size: 1.2rem;\"><i class=\"fa-solid fa-user-gear\"></i></div>\n                <div>\n                    <div style=\"font-weight: 700; color: #0f172a;\">Marcus Johnson</div>\n                    <div style=\"font-size: 0.9rem; color: #64748b;\">Lead Developer, StartupXYZ</div>\n                </div>\n            </div>\n        </div>\n        <div style=\"background: #fff; padding: 2rem; border-radius: 12px; box-shadow: 0 2px 8px rgba(0,0,0,0.04); border: 1px solid #e2e8f0;\">\n            <p style=\"font-size: 1.05rem; line-height: 1.7; color: #334155; margin-bottom: 1.5rem; font-style: italic;\">\"Incredible support team and a product that just works. We migrated our entire stack and haven't looked back.\"</p>\n            <div style=\"display: flex; align-items: center; gap: 1rem;\">\n                <div style=\"width: 48px; height: 48px; background: linear-gradient(135deg, #4facfe, #00f2fe); border-radius: 50%; display: flex; align-items: center; justify-content: center; color: #fff; font-size: 1.2rem;\"><i class=\"fa-solid fa-user-secret\"></i></div>\n                <div>\n                    <div style=\"font-weight: 700; color: #0f172a;\">Emily Rodriguez</div>\n                    <div style=\"font-size: 0.9rem; color: #64748b;\">Engineering Manager, DataFlow</div>\n                </div>\n            </div>\n        </div>\n    </div>\n</section>"
    },
    "pricing_cards": {
        "name": "Pricing Cards",
        "html": "<section style=\"padding: 6rem 5%; background: #fff;\">\n    <div style=\"text-align: center; margin-bottom: 4rem;\">\n        <h2 style=\"font-size: 2.5rem; font-weight: 800; color: #0f172a; margin-bottom: 1rem;\">Simple, transparent pricing</h2>\n        <p style=\"font-size: 1.1rem; color: #64748b;\">Choose the plan that's right for your team</p>\n    </div>\n    <div style=\"display: grid; grid-template-columns: repeat(3, 1fr); gap: 2rem; max-width: 1100px; margin: 0 auto;\">\n        <div style=\"background: #fff; padding: 2.5rem; border-radius: 16px; border: 2px solid #e2e8f0; transition: all 0.3s;\">\n            <h3 style=\"font-size: 1.5rem; font-weight: 700; color: #0f172a; margin-bottom: 0.5rem;\">Starter</h3>\n            <p style=\"color: #64748b; margin-bottom: 1.5rem;\">Perfect for small teams</p>\n            <div style=\"margin-bottom: 2rem;\">\n                <span style=\"font-size: 3rem; font-weight: 800; color: #0f172a;\">$29</span>\n                <span style=\"color: #64748b; font-size: 1.1rem;\">/month</span>\n            </div>\n            <ul style=\"list-style: none; padding: 0; margin: 0 0 2rem 0;\">\n                <li style=\"padding: 0.75rem 0; color: #334155; display: flex; align-items: center; gap: 0.75rem;\"><span style=\"color: #10b981; font-weight: 700;\">✓</span> Up to 5 team members</li>\n                <li style=\"padding: 0.75rem 0; color: #334155; display: flex; align-items: center; gap: 0.75rem;\"><span style=\"color: #10b981; font-weight: 700;\">✓</span> 10 GB storage</li>\n                <li style=\"padding: 0.75rem 0; color: #334155; display: flex; align-items: center; gap: 0.75rem;\"><span style=\"color: #10b981; font-weight: 700;\">✓</span> Basic analytics</li>\n                <li style=\"padding: 0.75rem 0; color: #334155; display: flex; align-items: center; gap: 0.75rem;\"><span style=\"color: #10b981; font-weight: 700;\">✓</span> Email support</li>\n            </ul>\n            <a href=\"#\" class=\"btn btn-outline\" style=\"width: 100%; text-align: center; padding: 1rem;\">Get Started</a>\n        </div>\n        <div style=\"background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); padding: 2.5rem; border-radius: 16px; transform: scale(1.05); box-shadow: 0 8px 24px rgba(102, 126, 234, 0.3); position: relative;\">\n            <div style=\"position: absolute; top: -12px; right: 20px; background: #fbbf24; color: #0f172a; padding: 0.5rem 1rem; border-radius: 50px; font-size: 0.75rem; font-weight: 700;\">POPULAR</div>\n            <h3 style=\"font-size: 1.5rem; font-weight: 700; color: #fff; margin-bottom: 0.5rem;\">Professional</h3>\n            <p style=\"color: rgba(255,255,255,0.9); margin-bottom: 1.5rem;\">For growing businesses</p>\n            <div style=\"margin-bottom: 2rem;\">\n                <span style=\"font-size: 3rem; font-weight: 800; color: #fff;\">$79</span>\n                <span style=\"color: rgba(255,255,255,0.9); font-size: 1.1rem;\">/month</span>\n            </div>\n            <ul style=\"list-style: none; padding: 0; margin: 0 0 2rem 0;\">\n                <li style=\"padding: 0.75rem 0; color: #fff; display: flex; align-items: center; gap: 0.75rem;\"><span style=\"font-weight: 700;\">✓</span> Up to 25 team members</li>\n                <li style=\"padding: 0.75rem 0; color: #fff; display: flex; align-items: center; gap: 0.75rem;\"><span style=\"font-weight: 700;\">✓</span> 100 GB storage</li>\n                <li style=\"padding: 0.75rem 0; color: #fff; display: flex; align-items: center; gap: 0.75rem;\"><span style=\"font-weight: 700;\">✓</span> Advanced analytics</li>\n                <li style=\"padding: 0.75rem 0; color: #fff; display: flex; align-items: center; gap: 0.75rem;\"><span style=\"font-weight: 700;\">✓</span> Priority support</li>\n                <li style=\"padding: 0.75rem 0; color: #fff; display: flex; align-items: center; gap: 0.75rem;\"><span style=\"font-weight: 700;\">✓</span> Custom integrations</li>\n            </ul>\n            <a href=\"#\" class=\"btn btn-primary\" style=\"width: 100%; text-align: center; padding: 1rem; background: #fff; color: #667eea;\">Get Started</a>\n        </div>\n        <div style=\"background: #fff; padding: 2.5rem; border-radius: 16px; border: 2px solid #e2e8f0;\">\n            <h3 style=\"font-size: 1.5rem; font-weight: 700; color: #0f172a; margin-bottom: 0.5rem;\">Enterprise</h3>\n            <p style=\"color: #64748b; margin-bottom: 1.5rem;\">For large organizations</p>\n            <div style=\"margin-bottom: 2rem;\">\n                <span style=\"font-size: 3rem; font-weight: 800; color: #0f172a;\">$199</span>\n                <span style=\"color: #64748b; font-size: 1.1rem;\">/month</span>\n            </div>\n            <ul style=\"list-style: none; padding: 0; margin: 0 0 2rem 0;\">\n                <li style=\"padding: 0.75rem 0; color: #334155; display: flex; align-items: center; gap: 0.75rem;\"><span style=\"color: #10b981; font-weight: 700;\">✓</span> Unlimited team members</li>\n                <li style=\"padding: 0.75rem 0; color: #334155; display: flex; align-items: center; gap: 0.75rem;\"><span style=\"color: #10b981; font-weight: 700;\">✓</span> Unlimited storage</li>\n                <li style=\"padding: 0.75rem 0; color: #334155; display: flex; align-items: center; gap: 0.75rem;\"><span style=\"color: #10b981; font-weight: 700;\">✓</span> Enterprise analytics</li>\n                <li style=\"padding: 0.75rem 0; color: #334155; display: flex; align-items: center; gap: 0.75rem;\"><span style=\"color: #10b981; font-weight: 700;\">✓</span> 24/7 phone support</li>\n                <li style=\"padding: 0.75rem 0; color: #334155; display: flex; align-items: center; gap: 0.75rem;\"><span style=\"color: #10b981; font-weight: 700;\">✓</span> Dedicated account manager</li>\n                <li style=\"padding: 0.75rem 0; color: #334155; display: flex; align-items: center; gap: 0.75rem;\"><span style=\"color: #10b981; font-weight: 700;\">✓</span> SLA guarantee</li>\n            </ul>\n            <a href=\"#\" class=\"btn btn-outline\" style=\"width: 100%; text-align: center; padding: 1rem;\">Contact Sales</a>\n        </div>\n    </div>\n</section>"
    },
    "stats_counter": {
        "name": "Stats Counter",
        "html": "<section style=\"padding: 5rem 5%; background: linear-gradient(135deg, #0f172a 0%, #1e293b 100%); color: #fff;\">\n    <div style=\"display: grid; grid-template-columns: repeat(4, 1fr); gap: 3rem; max-width: 1200px; margin: 0 auto;\">\n        <div style=\"text-align: center;\">\n            <div style=\"font-size: 3.5rem; font-weight: 900; margin-bottom: 0.5rem; background: linear-gradient(135deg, #667eea, #764ba2); -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text;\">10K+</div>\n            <div style=\"font-size: 1.1rem; color: #94a3b8; font-weight: 500;\">Active Users</div>\n        </div>\n        <div style=\"text-align: center;\">\n            <div style=\"font-size: 3.5rem; font-weight: 900; margin-bottom: 0.5rem; background: linear-gradient(135deg, #f093fb, #f5576c); -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text;\">99.9%</div>\n            <div style=\"font-size: 1.1rem; color: #94a3b8; font-weight: 500;\">Uptime SLA</div>\n        </div>\n        <div style=\"text-align: center;\">\n            <div style=\"font-size: 3.5rem; font-weight: 900; margin-bottom: 0.5rem; background: linear-gradient(135deg, #4facfe, #00f2fe); -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text;\">50M+</div>\n            <div style=\"font-size: 1.1rem; color: #94a3b8; font-weight: 500;\">API Requests Daily</div>\n        </div>\n        <div style=\"text-align: center;\">\n            <div style=\"font-size: 3.5rem; font-weight: 900; margin-bottom: 0.5rem; background: linear-gradient(135deg, #43e97b, #38f9d7); -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text;\">150+</div>\n            <div style=\"font-size: 1.1rem; color: #94a3b8; font-weight: 500;\">Countries Served</div>\n        </div>\n    </div>\n</section>"
    },
    "contact_form": {
        "name": "Contact Form",
        "html": "<section style=\"padding: 6rem 5%; background: #f8fafc;\">\n    <div style=\"max-width: 600px; margin: 0 auto;\">\n        <div style=\"text-align: center; margin-bottom: 3rem;\">\n            <h2 style=\"font-size: 2.5rem; font-weight: 800; color: #0f172a; margin-bottom: 1rem;\">Get in touch</h2>\n            <p style=\"font-size: 1.1rem; color: #64748b;\">Have a question? We'd love to hear from you. Send us a message and we'll respond as soon as possible.</p>\n        </div>\n        <form style=\"background: #fff; padding: 2.5rem; border-radius: 16px; box-shadow: 0 4px 16px rgba(0,0,0,0.06); border: 1px solid #e2e8f0;\">\n            <div style=\"margin-bottom: 1.5rem;\">\n                <label style=\"display: block; font-weight: 600; color: #334155; margin-bottom: 0.5rem;\">Your Name</label>\n                <input type=\"text\" placeholder=\"John Doe\" style=\"width: 100%; padding: 0.875rem 1rem; border: 1.5px solid #e2e8f0; border-radius: 8px; font-size: 1rem; transition: border-color 0.2s;\" onfocus=\"this.style.borderColor='#667eea'\" onblur=\"this.style.borderColor='#e2e8f0'\">\n            </div>\n            <div style=\"margin-bottom: 1.5rem;\">\n                <label style=\"display: block; font-weight: 600; color: #334155; margin-bottom: 0.5rem;\">Email Address</label>\n                <input type=\"email\" placeholder=\"john@example.com\" style=\"width: 100%; padding: 0.875rem 1rem; border: 1.5px solid #e2e8f0; border-radius: 8px; font-size: 1rem; transition: border-color 0.2s;\" onfocus=\"this.style.borderColor='#667eea'\" onblur=\"this.style.borderColor='#e2e8f0'\">\n            </div>\n            <div style=\"margin-bottom: 1.5rem;\">\n                <label style=\"display: block; font-weight: 600; color: #334155; margin-bottom: 0.5rem;\">Subject</label>\n                <input type=\"text\" placeholder=\"How can we help?\" style=\"width: 100%; padding: 0.875rem 1rem; border: 1.5px solid #e2e8f0; border-radius: 8px; font-size: 1rem; transition: border-color 0.2s;\" onfocus=\"this.style.borderColor='#667eea'\" onblur=\"this.style.borderColor='#e2e8f0'\">\n            </div>\n            <div style=\"margin-bottom: 2rem;\">\n                <label style=\"display: block; font-weight: 600; color: #334155; margin-bottom: 0.5rem;\">Message</label>\n                <textarea placeholder=\"Tell us more about your inquiry...\" rows=\"5\" style=\"width: 100%; padding: 0.875rem 1rem; border: 1.5px solid #e2e8f0; border-radius: 8px; font-size: 1rem; resize: vertical; font-family: inherit; transition: border-color 0.2s;\" onfocus=\"this.style.borderColor='#667eea'\" onblur=\"this.style.borderColor='#e2e8f0'\"></textarea>\n            </div>\n            <button type=\"submit\" class=\"btn btn-primary\" style=\"width: 100%; padding: 1rem; font-size: 1.05rem; font-weight: 700; background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);\">Send Message</button>\n        </form>\n    </div>\n</section>"
    }
}